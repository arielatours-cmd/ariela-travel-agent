SERPAPI_API_KEY=
BOOKING_LINK_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-service.onrender.com

# Outbound email (mailer.py) - used for password-reset emails. MAIL_APP_PASSWORD
# is a Google "App Password" (16 characters, generated under the Gmail
# account's Security settings once 2-Step Verification is on) - never the
# account's real login password. Defaults already point at Gmail's SMTP.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465

# Business details shown in the site footer (task 004a) - leave empty to
# keep the footer exactly as it is today.
BUSINESS_TRADE_NAME=
BUSINESS_LEGAL_NAME_HE=
BUSINESS_LEGAL_NAME_EN=
BUSINESS_DEALER_TYPE_HE=
BUSINESS_DEALER_NUMBER=
BUSINESS_ADDRESS_HE=
BUSINESS_ADDRESS_EN=
BUSINESS_CONTACT_EMAIL=

# CJ Commission Detail API (task 001a) - booking-credit detection.
CJ_API_TOKEN=
CJ_PUBLISHER_ID=
CJ_COMMISSIONS_SYNC_ENABLED=false

# WhatsApp send (existing) + inbound Ariella (task 006a, stage 1 - allowlisted
# numbers only). WHATSAPP_INBOUND_ENABLED stays false until Render and Meta
# are both configured and the business owner is ready to go live.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_INBOUND_ENABLED=false
WHATSAPP_INBOUND_ALLOWLIST=
# Task 006b: optional - only needed for /admin/whatsapp-subscription to check
# (and, with ?apply=1, fix) whether the app is subscribed to this WABA's
# messages webhook. Left empty, that check tries to resolve it via the API.
WHATSAPP_WABA_ID=
